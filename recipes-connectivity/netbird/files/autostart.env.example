# NetBird settings -> /etc/netbird/autostart.env on the device.
# Copy to autostart.env (git-ignored) and fill in. Sourced by netbird-autostart;
# each NB_* variable means the same as the matching "netbird up" flag.

# Setup key (--setup-key). Leave it out to ship an image without a key and
# provision it per device later (add NB_SETUP_KEY here, or set
# NB_SETUP_KEY_FILE=/etc/netbird/setup-key and drop the key into that file).
NB_SETUP_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Self-hosted server (--management-url, --admin-url)
#NB_MANAGEMENT_URL=https://netbird.example.com:443
#NB_ADMIN_URL=https://netbird.example.com

# Peer name (--hostname); default is the device hostname
#NB_HOSTNAME=device-001

# Do not let NetBird manage DNS (remove to enable NetBird DNS)
NB_DISABLE_DNS=true

# NetBird SSH server (--allow-server-ssh) and root login (--enable-ssh-root)
#NB_ALLOW_SERVER_SSH=true
#NB_ENABLE_SSH_ROOT=true
